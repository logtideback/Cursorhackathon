# Supabase (required for auth and data)
# Public keys only — never add SUPABASE_SERVICE_ROLE_KEY to the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App environment: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Seed / server only (never ship to Expo)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Optional analytics vendors (leave unset for console-only development)
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# EXPO_PUBLIC_AMPLITUDE_API_KEY=

# Legal / support (store listings + in-app placeholders)
# EXPO_PUBLIC_PRIVACY_URL=https://taste.app/privacy
# EXPO_PUBLIC_TERMS_URL=https://taste.app/terms
# EXPO_PUBLIC_SUPPORT_EMAIL=support@taste.app
# EXPO_PUBLIC_UNIVERSAL_LINK_HOST=taste.app

# Crash reporting (adapter placeholder until @sentry/react-native is wired)
# EXPO_PUBLIC_SENTRY_DSN=

# EAS / native identifiers (override placeholders in app.config.ts)
# EAS_PROJECT_ID=
# IOS_BUNDLE_IDENTIFIER=app.taste.mobile
# ANDROID_PACKAGE_NAME=app.taste.mobile
# IOS_BUILD_NUMBER=
# ANDROID_VERSION_CODE=
# EAS_UPDATE_URL=
